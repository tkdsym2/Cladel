{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filonex",
  "version": "0.1.0",
  "identifier": "com.filonex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Filonex",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["../sample/sample.flnx"],
    "category": "DeveloperTool",
    "shortDescription": "Research thought-mapping application",
    "longDescription": "Filonex is a desktop application for researchers to organize thinking as a knowledge graph. Combines literature management, personal thought mapping, and AI agents as collaborative research partners.",
    "copyright": "Copyright (c) 2026 Filonex",
    "fileAssociations": [
      {
        "ext": ["flnx"],
        "name": "Filonex Document",
        "description": "Filonex Document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-filonex",
        "contentTypes": ["com.filonex.document"],
        "exportedType": {
          "identifier": "com.filonex.document",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "files": {
        "Resources/flnx.icns": "./icons/flnx.icns"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/tkdsym2/Filonex/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RTNDRjg1MzI2N0IxN0UKUldSK3NXY3loYy9qNTFsQmhSYVgrSVpSdlkvRHdLbDNET3lrbWFweVhYWGVodElIQkpGdjFNblAK"
    }
  }
}
